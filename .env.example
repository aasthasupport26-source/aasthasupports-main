# ============================================================================
# AASTHA SUPPORT - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git - it's already in .gitignore
#
# HOW TO USE:
# 1. cp .env.example .env
# 2. Fill in all REQUIRED fields (marked with 🚨)
# 3. Configure RECOMMENDED fields (marked with ⚠️)
# 4. Test in development before deploying to production
# ============================================================================

# ─── Supabase Configuration (🚨 REQUIRED) ───────────────────────────────────
SUPABASE_PROJECT_ID="your_project_id_here"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Client-side (VITE_ prefix for browser access)
VITE_SUPABASE_PROJECT_ID="your_project_id_here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"

# ─── Shopify Configuration (🚨 REQUIRED) ────────────────────────────────────
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
VITE_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="your_storefront_access_token_here"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_your_admin_token_here"
SHOPIFY_API_VERSION="2024-10"
SHOPIFY_STORE_ID="your_store_id_here"
SHOPIFY_CLIENT_ID="your_oauth_client_id_here"
SHOPIFY_CLIENT_SECRET="your_oauth_client_secret_here"
SHOPIFY_ACCOUNT_URL="https://shopify.com/YOUR_STORE_ID/account"
VITE_SHOPIFY_REDIRECT_URI="https://www.yourdomain.com/auth/callback"

# ─── Razorpay Payment Gateway (🚨 REQUIRED) ─────────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys
# Use TEST keys for development, LIVE keys for production
RAZORPAY_KEY_ID="rzp_test_or_live_key_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# ─── Admin Authentication (🚨 REQUIRED) ─────────────────────────────────────
# Generate a strong random secret (minimum 32 characters):
# Option 1: openssl rand -base64 32
# Option 2: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Option 3: https://generate-secret.vercel.app/32
ADMIN_JWT_SECRET="generate_a_strong_random_secret_min_32_chars_CHANGE_THIS"

# ─── Sentry Error Monitoring (⚠️ RECOMMENDED) ───────────────────────────────
# Get your DSN from https://sentry.io/settings/projects/
# Helps track errors in production
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
VITE_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# ─── Shiprocket (Optional - for automated shipping) ─────────────────────────
SHIPROCKET_EMAIL="your_shiprocket_email@example.com"
SHIPROCKET_PASSWORD="your_shiprocket_password"
SHIPROCKET_WEBHOOK_SECRET="your_shiprocket_webhook_secret"

# ─── Application Settings ───────────────────────────────────────────────────
NODE_ENV="production"
VITE_APP_URL="https://www.yourdomain.com"

# ─── Email Configuration (Optional) ─────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"

# ─── Admin Contact ──────────────────────────────────────────────────────────
ADMIN_EMAIL="aastha.support.26@gmail.com"
